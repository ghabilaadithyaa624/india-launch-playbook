{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ghabilaadithyaa624/india-launch-playbook/schemas/agent-output.schema.json",
  "title": "IndiaLaunchAgentOutput",
  "description": "Structured contract every specialist agent MUST satisfy. Prose is not an acceptable agent output. Facts must be traceable to a retrieved source; anything else is an assumption or an estimate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "agent",
    "generated_at",
    "input_digest",
    "executive_summary",
    "facts",
    "assumptions",
    "estimates",
    "recommendations",
    "risks",
    "dependencies",
    "sources",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },

    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}$",
      "description": "UUID shared by every artifact in one generation run."
    },

    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "model", "prompt_sha256"],
      "properties": {
        "id": {
          "enum": [
            "market_research",
            "regulatory_compliance",
            "market_entry",
            "competitive_landscape",
            "go_to_market",
            "financial_projections",
            "risk_management",
            "implementation_roadmap"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "model": { "type": "string", "minLength": 1 },
        "prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },

    "generated_at": { "type": "string", "format": "date-time" },

    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "sha256 of the canonicalised business-idea input. Ties output to the exact question asked."
    },

    "executive_summary": { "type": "string", "minLength": 120, "maxLength": 4000 },

    "facts": {
      "type": "array",
      "description": "Claims traceable to a retrieved source. EVERY item needs >=1 source_id resolving to a non-model source.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "source_ids", "as_of", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{3}$" },
          "statement": { "type": "string", "minLength": 10 },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": ["string", "null"] },
          "as_of": { "type": "string", "format": "date" },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^S[0-9]{3}$" }
          },
          "verification": {
            "enum": ["primary_source_verified", "secondary_source", "unverified"]
          }
        }
      }
    },

    "assumptions": {
      "type": "array",
      "description": "Stated beliefs that are NOT evidenced. Must declare blast radius and how to test them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "rationale", "impact_if_wrong", "validation_method"],
        "properties": {
          "id": { "type": "string", "pattern": "^A[0-9]{3}$" },
          "statement": { "type": "string", "minLength": 10 },
          "rationale": { "type": "string", "minLength": 10 },
          "impact_if_wrong": { "enum": ["low", "medium", "high", "critical"] },
          "validation_method": { "type": "string", "minLength": 10 }
        }
      }
    },

    "estimates": {
      "type": "array",
      "description": "Derived numbers. Point estimates are banned: low/base/high required so uncertainty survives into the document.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "low", "base", "high", "unit", "method", "depends_on"],
        "properties": {
          "id": { "type": "string", "pattern": "^E[0-9]{3}$" },
          "metric": { "type": "string", "minLength": 3 },
          "low": { "type": "number" },
          "base": { "type": "number" },
          "high": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "method": {
            "enum": ["top_down", "bottom_up", "analogy", "benchmark", "expert_judgement"]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[FAE][0-9]{3}$" }
          }
        }
      }
    },

    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "priority", "owner_role", "rationale_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]{3}$" },
          "action": { "type": "string", "minLength": 10 },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "owner_role": { "type": "string", "minLength": 2 },
          "effort": { "enum": ["S", "M", "L", "XL"] },
          "rationale_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[FAEK][0-9]{3}$" }
          },
          "requires_professional_review": { "type": "boolean", "default": false }
        }
      }
    },

    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "category", "likelihood", "impact", "mitigation"],
        "properties": {
          "id": { "type": "string", "pattern": "^K[0-9]{3}$" },
          "description": { "type": "string", "minLength": 10 },
          "category": {
            "enum": [
              "market",
              "regulatory",
              "operational",
              "financial",
              "competitive",
              "reputational",
              "technology"
            ]
          },
          "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "mitigation": { "type": "string", "minLength": 10 },
          "early_warning_indicator": { "type": "string" }
        }
      }
    },

    "dependencies": {
      "type": "array",
      "description": "Declared relationships to other agents. Drives synthesis ordering and contradiction checks.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "relationship"],
        "properties": {
          "agent_id": {
            "enum": [
              "market_research",
              "regulatory_compliance",
              "market_entry",
              "competitive_landscape",
              "go_to_market",
              "financial_projections",
              "risk_management",
              "implementation_roadmap"
            ]
          },
          "relationship": { "enum": ["requires", "informs", "may_contradict"] },
          "note": { "type": "string" }
        }
      }
    },

    "sources": {
      "type": "array",
      "description": "Source register. 'model_internal_knowledge' is allowed to EXIST but may never back a fact.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "publisher", "title", "accessed_at", "retrieval_method"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{3}$" },
          "type": {
            "enum": [
              "primary_regulator",
              "government_statistics",
              "peer_reviewed",
              "industry_report",
              "news",
              "company_filing",
              "operator_supplied",
              "model_internal_knowledge"
            ]
          },
          "publisher": { "type": "string", "minLength": 2 },
          "title": { "type": "string", "minLength": 2 },
          "url": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"], "format": "date" },
          "accessed_at": { "type": "string", "format": "date" },
          "retrieval_method": { "enum": ["web_fetch", "operator_supplied", "none"] }
        }
      }
    },

    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "basis"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "string", "minLength": 10 },
        "low_confidence_area_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[FAEKR][0-9]{3}$" }
        }
      }
    },

    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Replaces line-count targets. Completeness is measured by sections answered, never by volume of text.",
      "properties": {
        "required_sections_present": { "type": "array", "items": { "type": "string" } },
        "unanswered_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
