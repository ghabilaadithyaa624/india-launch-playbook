{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ghabilaadithyaa624/india-launch-playbook/schemas/run-input.schema.json",
  "title": "RunInput",
  "description": "The business idea a user submits. This is the missing 'USER ENTERS A BUSINESS IDEA' entry point. Validated before any token is spent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["business_idea", "sector", "target_customer", "geography"],
  "properties": {
    "business_idea": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2000,
      "description": "Plain-language description of what the business does."
    },
    "sector": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "description": "e.g. 'B2B SaaS', 'D2C packaged food', 'fintech lending', 'logistics marketplace'."
    },
    "target_customer": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "geography": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 2 },
      "description": "e.g. ['Delhi-NCR','Mumbai'] or ['Pan-India']."
    },
    "budget_band": {
      "enum": ["under_25L", "25L_1Cr", "1Cr_5Cr", "above_5Cr", "unknown"],
      "default": "unknown"
    },
    "stage": {
      "enum": ["idea", "prototype", "pre_revenue", "revenue", "scaling"],
      "default": "idea"
    },
    "operator_sources": {
      "type": "array",
      "description": "Optional documents the operator supplies as evidence (their own research, quotes, letters).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "publisher", "content"],
        "properties": {
          "title": { "type": "string", "minLength": 2 },
          "publisher": { "type": "string", "minLength": 2 },
          "url": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"], "format": "date" },
          "content": { "type": "string", "minLength": 20, "maxLength": 200000 }
        }
      }
    }
  }
}
