# ---------------------------------------------------------------------------
# India Launch Playbook — environment template
# Copy to .env  (.env is git-ignored and MUST NEVER be committed)
#
# SECURITY RULES
#   1. Never paste a real key into any .json / .md file in this repo.
#      Workflow files are tracked by git; .env is not.
#   2. In n8n, store secrets in the n8n Credential store, NOT in node parameters.
#   3. Use a FINE-GRAINED GitHub token scoped to THIS repository only.
# ---------------------------------------------------------------------------

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-opus-5
# Anthropic Messages API version header (required)
ANTHROPIC_VERSION=2023-06-01

# --- GitHub ------------------------------------------------------------------
# Fine-grained personal access token.
#   Repository access : ONLY ghabilaadithyaa624/india-launch-playbook
#   Permissions       : Contents = Read and write
#                       Pull requests = Read and write
#   Expiration        : 90 days or less
# Do NOT use a classic token with the broad `repo` scope.
GITHUB_TOKEN=github_pat_REPLACE_ME
GITHUB_REPO=ghabilaadithyaa624/india-launch-playbook
# Branch that generated runs are PR'd INTO. Never written to directly.
GITHUB_BASE_BRANCH=main

# --- Pipeline ----------------------------------------------------------------
# Hard ceiling. Publishing refuses any path outside this prefix.
OUTPUT_PATH_PREFIX=runs/
# Set to 1 to allow the publisher to actually open a PR. Anything else = dry run.
PUBLISH_ENABLED=0
